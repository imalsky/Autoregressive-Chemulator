#!/bin/bash
#PBS -N AUTOCHEM_S2
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=72:ngpus=1:mem=400gb:model=gh200
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -m abe

# Stage 2 (autoregressive fine-tune) of the single dt-conditioned production model.
#
# Loads the stage-1 checkpoint (EMA weights preferred automatically) via
# checkpoint_mode=weights_only and fine-tunes with configs/stage2.json. Re-running
# the job auto-resumes from stage 2's own last checkpoint.
#
# Prereq: stage 1 must have finished (run.pbs). Submit after stage 1, e.g.:
#   qsub -W depend=afterok:<stage1_jobid> run_stage2.pbs
#
# Evidence for every non-default config value: docs/DECISIONS.md.

set -euo pipefail

cd -P "${PROJECT_ROOT:-${PBS_O_WORKDIR:?}}"
PROJECT_ROOT="$(pwd -P)"

readonly CONFIG="${PROJECT_ROOT}/configs/stage2.json"
readonly THREADS="${AUTOCHEM_THREADS:-16}"
readonly RUN_ID="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
readonly LOG_DIR="${PROJECT_ROOT}/logs"
readonly RUNTIME_CFG_DIR="${LOG_DIR}/_runtime"

log()  { printf '[%(%Y-%m-%dT%H:%M:%S%z)T] %s\n' -1 "$*"; }
fail() { log "ERROR: $*"; exit 1; }

[ -f "${CONFIG}" ] || fail "missing config: ${CONFIG}"

# resolve_cfg_path <config> <paths-key> -> absolute path (paths are relative to the config dir).
resolve_cfg_path() {
  python - "$1" "$2" <<'PY'
import json, sys
from pathlib import Path
cfg_path, key = Path(sys.argv[1]), sys.argv[2]
cfg = json.loads(cfg_path.read_text())
p = Path(cfg["paths"][key])
print(p if p.is_absolute() else (cfg_path.parent / p).resolve())
PY
}

# resolve_runtime_checkpoint <config> -> absolute path of the stage-1 checkpoint it loads.
resolve_runtime_checkpoint() {
  python - "$1" <<'PY'
import json, sys
from pathlib import Path
cfg_path = Path(sys.argv[1])
cfg = json.loads(cfg_path.read_text())
ckpt = cfg["runtime"]["checkpoint"]
if not isinstance(ckpt, str) or not ckpt:
    raise SystemExit("runtime.checkpoint must be a non-empty string in the stage-2 config")
p = Path(ckpt)
print(p if p.is_absolute() else (cfg_path.parent / p).resolve())
PY
}

# ---- Conda (HPC cluster environment) ----
module purge
module use -a /swbuild/analytix/tools/modulefiles
module load miniconda3/gh2
CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1090
source "${CONDA_BASE}/etc/profile.d/conda.sh"
CONDA_ENV="${CONDA_ENV:-pyt2_8_gh}"
conda activate "${CONDA_ENV}" || fail "failed to activate conda env: ${CONDA_ENV}"

# GH200 needs the ARM-native h5py build (the x86 wheel may be cached).
pip uninstall -y h5py || true
pip install h5py --no-cache-dir

mkdir -p "${LOG_DIR}" "${RUNTIME_CFG_DIR}" "${PROJECT_ROOT}/data" "${PROJECT_ROOT}/models"

export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS="${THREADS}"
export MKL_NUM_THREADS="${THREADS}"
export OPENBLAS_NUM_THREADS="${THREADS}"
export NUMEXPR_NUM_THREADS="${THREADS}"
export PYTHONUNBUFFERED=1
export PYTHONPATH="${PROJECT_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
export AUTOCHEM_CONFIG_PATH="${CONFIG}"

PROCESSED_DIR="$(resolve_cfg_path "${CONFIG}" processed_dir)"
WORK_DIR="$(resolve_cfg_path "${CONFIG}" work_dir)"
STAGE1_CKPT="$(resolve_runtime_checkpoint "${CONFIG}")"

# ---- Preconditions ----
[ -f "${PROCESSED_DIR}/normalization.json" ] || fail "processed dataset missing: ${PROCESSED_DIR} (run run.pbs first)"
[ -f "${STAGE1_CKPT}" ] || fail "stage-1 checkpoint missing: ${STAGE1_CKPT} (run run.pbs first)"
log "stage-1 checkpoint: ${STAGE1_CKPT}"

# ---- Train stage 2 (auto-resume from stage 2's own checkpoint if present) ----
LAST_CKPT="${WORK_DIR}/checkpoints/last.ckpt"
if [ -f "${LAST_CKPT}" ]; then
  log "resuming stage-2 from ${LAST_CKPT}"
  RESUME_CFG="${RUNTIME_CFG_DIR}/stage2.resume.json"
  # Resume copy: checkpoint_mode=resume pointing at stage-2's own last.ckpt, ABSOLUTE paths.
  python - "${CONFIG}" "${LAST_CKPT}" "${RESUME_CFG}" <<'PY'
import json, sys
from pathlib import Path
src, ckpt, out = Path(sys.argv[1]), sys.argv[2], Path(sys.argv[3])
cfg = json.loads(src.read_text())
base = src.parent
for key in ("raw_dir", "processed_dir", "work_dir"):
    p = Path(cfg["paths"][key])
    cfg["paths"][key] = str(p if p.is_absolute() else (base / p).resolve())
cfg["training"]["checkpoint_mode"] = "resume"
cfg.setdefault("runtime", {})["checkpoint"] = str(Path(ckpt).resolve())
out.write_text(json.dumps(cfg, indent=2))
PY
  AUTOCHEM_CONFIG_PATH="${RESUME_CFG}" python -u src/main.py
else
  log "fresh stage-2 fine-tune (weights_only from stage 1) -> ${WORK_DIR}"
  python -u src/main.py
fi

# ---- Validate outputs ----
[ -f "${WORK_DIR}/config.resolved.json" ] || fail "missing ${WORK_DIR}/config.resolved.json"
[ -f "${WORK_DIR}/metrics.csv" ]          || fail "missing ${WORK_DIR}/metrics.csv"
ls "${WORK_DIR}"/checkpoints/*.ckpt >/dev/null 2>&1 || fail "no checkpoints in ${WORK_DIR}/checkpoints"
log "stage-2 complete (run ${RUN_ID}); checkpoints in ${WORK_DIR}/checkpoints"
