#!/bin/bash
#PBS -N AUTOCHEM_S1
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=72:ngpus=1:mem=400gb:model=gh200
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -m abe

# Stage 1 (one-jump pretrain) of the single dt-conditioned production model.
#
# Pipeline: preprocess once (skipped if the processed dataset already exists) ->
# train with configs/stage1.json. Re-running the job auto-resumes from the last
# checkpoint, so it is safe to requeue when a run exceeds the walltime.
#
# Submit:  qsub run.pbs
# Stage 2: qsub -W depend=afterok:<this_jobid> run_stage2.pbs
#
# Evidence for every non-default config value: docs/DECISIONS.md.

set -euo pipefail

cd -P "${PROJECT_ROOT:-${PBS_O_WORKDIR:?}}"
PROJECT_ROOT="$(pwd -P)"

readonly CONFIG="${PROJECT_ROOT}/configs/stage1.json"
readonly THREADS="${AUTOCHEM_THREADS:-16}"
readonly RUN_ID="${PBS_JOBID:-manual_$(date +%Y%m%d_%H%M%S)}"
readonly LOG_DIR="${PROJECT_ROOT}/logs"
readonly RUNTIME_CFG_DIR="${LOG_DIR}/_runtime"

log()  { printf '[%(%Y-%m-%dT%H:%M:%S%z)T] %s\n' -1 "$*"; }
fail() { log "ERROR: $*"; exit 1; }

[ -f "${CONFIG}" ] || fail "missing config: ${CONFIG}"

# Path resolution runs before the conda setup so a doomed requeue dies in
# seconds; it needs only a stdlib python already on PATH.
PYBIN="$(command -v python3 || command -v python || true)"
[ -n "${PYBIN}" ] || fail "no python3/python on PATH to resolve config paths"

# resolve_cfg_path <config> <paths-key> -> absolute path (paths are relative to the config dir).
resolve_cfg_path() {
  "${PYBIN}" - "$1" "$2" <<'PY'
import json, sys
from pathlib import Path
cfg_path, key = Path(sys.argv[1]), sys.argv[2]
cfg = json.loads(cfg_path.read_text())
p = Path(cfg["paths"][key])
print(p if p.is_absolute() else (cfg_path.parent / p).resolve())
PY
}

PROCESSED_DIR="$(resolve_cfg_path "${CONFIG}" processed_dir)"
WORK_DIR="$(resolve_cfg_path "${CONFIG}" work_dir)"
LAST_CKPT="${WORK_DIR}/checkpoints/last.ckpt"

# A run that dies before its first checkpoint leaves a non-empty work_dir with no
# last.ckpt; the fresh branch below would then hard-fail inside main.py (fresh
# runs require an empty work_dir), so fail here with the remediation instead.
if [ ! -f "${LAST_CKPT}" ] && [ -d "${WORK_DIR}" ] && [ -n "$(ls -A "${WORK_DIR}" 2>/dev/null)" ]; then
  fail "work_dir ${WORK_DIR} is non-empty but has no ${LAST_CKPT}: a previous run crashed before its first checkpoint. Inspect, then remove the directory and resubmit."
fi

# ---- Conda (HPC cluster environment) ----
module purge
module use -a /swbuild/analytix/tools/modulefiles
module load miniconda3/gh2
CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1090
source "${CONDA_BASE}/etc/profile.d/conda.sh"
CONDA_ENV="${CONDA_ENV:-pyt2_8_gh}"
conda activate "${CONDA_ENV}" || fail "failed to activate conda env: ${CONDA_ENV}"

# GH200 needs the ARM-native h5py build (the x86 wheel may be cached).
# Reinstall is opt-in because the shared conda env is not writable on this cluster.
if [ "${REINSTALL_H5PY:-0}" = "1" ]; then
  pip install --user --no-cache-dir --force-reinstall h5py
fi
python -c "import h5py" >/dev/null 2>&1 \
  || fail "h5py not importable in ${CONDA_ENV}: install the ARM-native build into the env once, or resubmit with REINSTALL_H5PY=1"

mkdir -p "${LOG_DIR}" "${RUNTIME_CFG_DIR}" "${PROJECT_ROOT}/data" "${PROJECT_ROOT}/models"

export HDF5_USE_FILE_LOCKING=FALSE
export OMP_NUM_THREADS="${THREADS}"
export MKL_NUM_THREADS="${THREADS}"
export OPENBLAS_NUM_THREADS="${THREADS}"
export NUMEXPR_NUM_THREADS="${THREADS}"
export PYTHONUNBUFFERED=1
export PYTHONPATH="${PROJECT_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
export AUTOCHEM_CONFIG_PATH="${CONFIG}"

# ---- Preprocess once (skip if the normalized dataset already exists) ----
if [ -f "${PROCESSED_DIR}/normalization.json" ]; then
  log "processed dataset present: ${PROCESSED_DIR} (skipping preprocessing)"
else
  log "preprocessing -> ${PROCESSED_DIR}"
  python -u processing/preprocessing.py
fi

# ---- Train stage 1 (auto-resume if a checkpoint already exists) ----
if [ -f "${LAST_CKPT}" ]; then
  log "resuming stage-1 from ${LAST_CKPT}"
  RESUME_CFG="${RUNTIME_CFG_DIR}/stage1.resume.json"
  # Write a resume copy with checkpoint_mode=resume and ABSOLUTE paths (so it works
  # regardless of where the resume copy lives).
  python - "${CONFIG}" "${LAST_CKPT}" "${RESUME_CFG}" <<'PY'
import json, sys
from pathlib import Path
src, ckpt, out = Path(sys.argv[1]), sys.argv[2], Path(sys.argv[3])
cfg = json.loads(src.read_text())
base = src.parent
for key in ("raw_dir", "processed_dir", "work_dir"):
    p = Path(cfg["paths"][key])
    cfg["paths"][key] = str(p if p.is_absolute() else (base / p).resolve())
cfg["training"]["checkpoint_mode"] = "resume"
cfg.setdefault("runtime", {})["checkpoint"] = str(Path(ckpt).resolve())
out.write_text(json.dumps(cfg, indent=2))
PY
  AUTOCHEM_CONFIG_PATH="${RESUME_CFG}" python -u src/main.py
else
  log "fresh stage-1 training -> ${WORK_DIR}"
  python -u src/main.py
fi

# ---- Validate outputs ----
[ -f "${WORK_DIR}/config.resolved.json" ] || fail "missing ${WORK_DIR}/config.resolved.json"
[ -f "${WORK_DIR}/metrics.csv" ]          || fail "missing ${WORK_DIR}/metrics.csv"
ls "${WORK_DIR}"/checkpoints/*.ckpt >/dev/null 2>&1 || fail "no checkpoints in ${WORK_DIR}/checkpoints"
log "stage-1 complete (run ${RUN_ID}); checkpoints in ${WORK_DIR}/checkpoints"
