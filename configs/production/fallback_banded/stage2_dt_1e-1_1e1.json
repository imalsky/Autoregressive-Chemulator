{
  "_comment": [
    "FALLBACK banded layout (stage2, dt band 1e-1_1e1) \u2014 NOT the primary recommendation.",
    "E2 found band specialists collapse 5-40x at deployment-style fixed-dt rollouts even",
    "in-band, while the single full-range model holds (see DECISIONS.md, Gate G2).",
    "Delivered per the conservative keep-both-options policy: the sandbox band emulation",
    "conflates time-segment with dt-band more than Auto-Chem preprocessing does, so the",
    "production pathology may be milder. Use only if the single model shows a measured",
    "gap at the deployment dt that a deployment-dt-concentrated stage-2 cannot close."
  ],
  "precision": {
    "compute_dtype": "float32",
    "amp_mode": "true",
    "model_dtype": "float32",
    "input_dtype": "float32",
    "dataset_dtype": "float32",
    "preload_dtype": "float32",
    "loss_dtype": "float32"
  },
  "paths": {
    "raw_dir": "../../../data/raw",
    "processed_dir": "../../../data/processed_prod_dt_1e-1_1e1",
    "work_dir": "../../../models/prod_fallback_stage2_dt_1e-1_1e1"
  },
  "system": {
    "device": "cpu",
    "log_level": "INFO",
    "seed": 1234
  },
  "runtime": {
    "checkpoint": "../../../models/prod_fallback_stage1_dt_1e-1_1e1/checkpoints/last.ckpt",
    "load_weights_strict": true,
    "accelerator": "auto",
    "devices": "auto",
    "strategy": "auto",
    "accumulate_grad_batches": 1,
    "deterministic": false,
    "enable_progress_bar": false,
    "gradient_clip_val": 1.0,
    "log_every_n_steps": 1000000,
    "checkpointing": {
      "enabled": true,
      "every_n_epochs": 1,
      "monitor": "val_loss",
      "save_top_k": 3,
      "save_last": true
    },
    "torch_compile": {
      "enabled": true,
      "backend": "inductor",
      "mode": "default",
      "dynamic": false,
      "fullgraph": true,
      "compile_forward_step": true,
      "compile_open_loop_unroll": false
    }
  },
  "data": {
    "global_variables": [
      "P",
      "T"
    ],
    "species_variables": [
      "C2H2_evolution",
      "CH4_evolution",
      "CO2_evolution",
      "CO_evolution",
      "H2O_evolution",
      "H2_evolution",
      "HCN_evolution",
      "H_evolution",
      "N2_evolution",
      "NH3_evolution",
      "OH_evolution",
      "O_evolution"
    ]
  },
  "normalization": {
    "epsilon": 1e-30,
    "min_std": 1e-12,
    "globals_default_method": "standard",
    "methods": {
      "P": "log-min-max",
      "T": "min-max"
    }
  },
  "preprocessing": {
    "_comment": [
      "Identical to stage 1 \u2014 stage 2 reuses the same processed shards",
      "(data/processed_prod_dt_1e-1_1e3). Do NOT rerun preprocessing for stage 2."
    ],
    "raw_file_patterns": [
      "*.h5",
      "*.hdf5"
    ],
    "dt_min": 0.1,
    "dt_max": 10.0,
    "dt_sampling": "loguniform",
    "n_steps": 100,
    "t_min": 0.0,
    "output_trajectories_per_file": 1000000,
    "shard_size": 4096,
    "overwrite": false,
    "time_key": "t_time",
    "val_fraction": 0.1,
    "test_fraction": 0.1,
    "seed": 1234,
    "pool_size": 1000000,
    "samples_per_source_trajectory": 4,
    "max_chunk_attempts_per_source": 200,
    "drop_below": 1e-30
  },
  "dataset": {
    "windows_per_trajectory": 92,
    "preload_to_device": true,
    "shard_cache_size": 2
  },
  "model": {
    "type": "mlp",
    "activation": "silu",
    "dropout": 0.0,
    "layer_norm": true,
    "layer_norm_eps": 1e-05,
    "predict_delta": true,
    "fourier_dt": {
      "enabled": false,
      "num_freqs": 16,
      "sigma": 1.0,
      "seed": 0,
      "_comment": [
        "Disabled 2026-06-11 per F1/F2 (see DECISIONS.md): on the residual trunk,",
        "Fourier-dt was harmful at 135k-param scale, replicated across 2 seeds.",
        "Re-enable only if the production-scale spot-check contradicts this."
      ]
    },
    "mlp": {
      "hidden_dims": [
        2048,
        2048,
        2048,
        2048,
        2048,
        2048,
        2048,
        2048,
        2048,
        2048
      ],
      "residual": true
    },
    "autoencoder": {
      "latent_dim": 256,
      "encoder_hidden": 512,
      "decoder_hidden": 512,
      "dynamics_hidden": 512,
      "residual": true,
      "dynamics_residual": true
    }
  },
  "training": {
    "batch_size": 2048,
    "max_epochs": 200,
    "checkpoint_mode": "weights_only",
    "num_workers": 0,
    "pin_memory": true,
    "persistent_workers": false,
    "prefetch_factor": null,
    "rollout_steps": 10,
    "loss": {
      "lambda_log10_mae": 1.0,
      "lambda_z_mse": 0.25
    },
    "optimizer": {
      "name": "adamw",
      "lr": 3e-05,
      "weight_decay": 1e-05,
      "exclude_norm_and_bias_from_weight_decay": true,
      "betas": [
        0.9,
        0.999
      ],
      "eps": 1e-08,
      "fused": true,
      "foreach": false
    },
    "scheduler": {
      "enabled": true,
      "type": "reduce_on_plateau",
      "warmup_epochs": 5,
      "factor": 0.5,
      "patience": 10,
      "threshold": 0.0001,
      "min_lr": 1e-08,
      "mode": "min",
      "monitor": "val_loss"
    },
    "autoregressive_training": {
      "enabled": true,
      "skip_steps": 1,
      "detach_between_steps": false,
      "backward_per_step": false,
      "loss_discount_gamma": 1.0
    },
    "curriculum": {
      "enabled": true,
      "start_steps": 2,
      "end_steps": 10,
      "mode": "linear",
      "ramp_epochs": 30
    },
    "ema": {
      "enabled": true,
      "decay": 0.999
    },
    "early_stopping": {
      "enabled": true,
      "patience": 20,
      "min_delta": 1e-05
    }
  }
}
